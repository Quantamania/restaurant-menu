{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "/includes/(.*)",
      "status": 404
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/([a-z0-9-]+)$",
      "dest": "/$1.php"
    }
  ],
  "env": {
    "SESSION_DRIVER": "database"
  }
}
