{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.8.0"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.ico",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/includes/(.*)",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.php"
    },
    {
      "src": "/([a-z0-9-]+)$",
      "dest": "/$1.php"
    }
  ],
  "env": {
    "SESSION_DRIVER": "database"
  }
}
